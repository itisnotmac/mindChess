{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user this notification is for"
    },
    "type": {
      "type": "string",
      "enum": [
        "daily_puzzle_reminder",
        "streak_warning",
        "achievement"
      ],
      "default": "daily_puzzle_reminder"
    },
    "message": {
      "type": "string"
    },
    "link": {
      "type": "string",
      "default": "/tactics"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id",
    "message"
  ]
}