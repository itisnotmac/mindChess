{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "elo": {
      "type": "number",
      "default": 1200
    },
    "puzzle_rating": {
      "type": "number",
      "default": 1200
    },
    "puzzle_streak": {
      "type": "number",
      "default": 0
    },
    "longest_streak": {
      "type": "number",
      "default": 0
    },
    "total_games": {
      "type": "number",
      "default": 0
    },
    "total_puzzles": {
      "type": "number",
      "default": 0
    },
    "games_won": {
      "type": "number",
      "default": 0
    },
    "games_lost": {
      "type": "number",
      "default": 0
    },
    "games_drawn": {
      "type": "number",
      "default": 0
    },
    "puzzles_solved": {
      "type": "number",
      "default": 0
    },
    "puzzles_failed": {
      "type": "number",
      "default": 0
    },
    "accuracy_avg": {
      "type": "number",
      "default": 0
    },
    "openings_drilled": {
      "type": "number",
      "default": 0
    },
    "endgames_drilled": {
      "type": "number",
      "default": 0
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "elo_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "rating": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": []
}