{
  "name": "GameSession",
  "type": "object",
  "properties": {
    "moves": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "pgn": {
      "type": "string",
      "default": ""
    },
    "result": {
      "type": "string",
      "enum": [
        "win",
        "loss",
        "draw",
        "ongoing"
      ],
      "default": "ongoing"
    },
    "accuracy": {
      "type": "number",
      "default": 0
    },
    "ai_difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "easy",
        "intermediate",
        "advanced",
        "master"
      ],
      "default": "intermediate"
    },
    "player_color": {
      "type": "string",
      "enum": [
        "white",
        "black"
      ],
      "default": "white"
    },
    "elo_change": {
      "type": "number",
      "default": 0
    },
    "review_data": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    }
  },
  "required": []
}