{
  "name": "PuzzleAttempt",
  "type": "object",
  "properties": {
    "puzzle_id": {
      "type": "string"
    },
    "theme": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "enum": [
        "solved",
        "failed"
      ],
      "default": "failed"
    },
    "time_taken": {
      "type": "number",
      "default": 0
    },
    "rating_before": {
      "type": "number",
      "default": 1200
    },
    "rating_after": {
      "type": "number",
      "default": 1200
    }
  },
  "required": [
    "puzzle_id",
    "result"
  ]
}