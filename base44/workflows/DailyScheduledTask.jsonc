{
  "description": "A daily recurring workflow with a placeholder step. Runs every day at 9 AM UTC, forever.",
  "name": "Daily Scheduled Task",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_scheduled_task",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "placeholder_step": {
          "call": "invoke_backend_function",
          "with": {
